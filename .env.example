# Mesh API (mandatory — every LLM/AI call in this codebase routes through this)
MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1

# Search/scrape provider (Researcher agent — wired in Phase 2)
FIRECRAWL_API_KEY=

# App
DATABASE_URL=sqlite:///./deepdive.db
CHECKPOINT_DB_PATH=./checkpoints.db
LLM_CACHE_DIR=./.cache/llm
LLM_CACHE_ENABLED=true
LOG_LEVEL=INFO

# Budgets (per run) — enforced in core/budget.py, checked before every expensive call
BUDGET_USD_PER_RUN=2.00
BUDGET_TOKENS_PER_RUN=500000
DEADLINE_SECONDS_PER_RUN=600

# Circuit breaker (per-model, see llm/circuit_breaker.py)
CB_FAILURE_THRESHOLD=4
CB_COOLDOWN_SECONDS=60

# Concurrency cap on in-flight Mesh calls
MESH_MAX_CONCURRENCY=4

# Context & memory budgets (BLUEPRINT.md §12) — keep prompts and any one
# sub-question's evidence pool bounded as a run loops
MAX_PASSAGES_PER_CALL=12
MAX_PASSAGES_PER_SUBQUESTION=30
FOLLOWUP_TOP_K=10
RELEVANCE_PREFILTER_THRESHOLD=0.05

# Demo/auth — unused until the Hardening bucket (BLUEPRINT.md §16)
DEMO_MODE=local
API_KEY=
